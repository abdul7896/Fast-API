# Example secret values file for Helm deployment
# Copy this file to values-secret.yaml and fill in your actual values
# NEVER commit values-secret.yaml to version control!

secrets:
  # API key for authentication (generate a long, secure random string)
  API_KEY: "your_long_secure_api_key_here_minimum_32_characters_recommended_64_plus"
  
  # AWS credentials for accessing S3 and DynamoDB
  AWS_ACCESS_KEY_ID: "your_aws_access_key_id_here"
  AWS_SECRET_ACCESS_KEY: "your_aws_secret_access_key_here"

# Optional: Override default environment variables
env:
  AWS_REGION: "us-east-1"
  S3_BUCKET: "your-s3-bucket-name"
  DYNAMODB_TABLE: "your-dynamodb-table-name"

# Optional: Production-specific overrides
# replicaCount: 3
# 
# resources:
#   limits:
#     cpu: 1000m
#     memory: 1Gi
#   requests:
#     cpu: 500m
#     memory: 512Mi
#
# autoscaling:
#   minReplicas: 3
#   maxReplicas: 20
#   targetCPUUtilizationPercentage: 60
